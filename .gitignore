# 환경변수 (API 키 — 절대 커밋 금지)
.env
.env.local
.env.*.local

# 의존성
node_modules/

# 빌드 산출물
dist/
build/
*.tsbuildinfo

# 캐시 / 로컬 데이터
data/cache/
*.sqlite
*.sqlite-journal
*.db
*.db-shm
*.db-wal
tmp/
scratch/

# 로그
*.log
npm-debug.log*

# OS / 에디터
.DS_Store
Thumbs.db
.vscode/
.idea/

# 도구 로컬 캐시
.codegraph/

# 로컬 작업 기록
CLAUDE.local.md
CLAUDE.local.md.bak-*

# 외부 참고 소스 (타 프로젝트 코드 — 라이선스 불명, 커밋 금지)
(참고)소스/

# 리서치 수집 원본 (커뮤니티 스크랩 — 저작권·개인글 노출 위험, 결과물만 커밋)
RESEARCH/**/artifacts/
RESEARCH/**/state.json

# 공정위 매뉴얼 원본 PDF·텍스트 덤프 (공공저작물이지만 용량 — URL 은 README 에 기록, 추출 결과만 커밋)
RESEARCH/공정위매뉴얼_202604/*.pdf
RESEARCH/공정위매뉴얼_202604/txt_*.txt
.env.bak.*
