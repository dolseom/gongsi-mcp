# OpenDART 인증키 (필수)
# 발급: https://opendart.fss.or.kr → 인증키 신청/관리
# 한도: 일 20,000건
DART_API_KEY=

# 공공데이터포털 서비스키 (기업집단포털 API용, 선택)
# 발급: https://www.data.go.kr → 마이페이지 → 일반 인증키
# ※ API별로 "활용신청"을 따로 해야 합니다 (자동승인)
# 한도: 개발계정 일 10,000건
# 미설정 시 DART 단독 기능만 동작합니다
EGROUP_API_KEY=

# 법제처 OC (선택 — 법령 원문 조회용)
LAW_OC=


# ─────────────────────────────────────────────────────────────
# 운영 파라미터 (전부 선택 — 기본값은 참고 MCP 실측으로 검증된 값)
# 상세 근거: docs/absorbed-from-dart-mcp.md
# ※ 접두사는 DARTFTC_ 로 통일한다. 미인식 변수는 기동 시 경고 로그를 남긴다.
# ─────────────────────────────────────────────────────────────

# 일일 호출 한도 경고·하드스톱 (DART 일 20,000건 기준)
# 하드스톱은 "원문 다운로드"만 거부하고 목록 조회는 계속 허용한다.
# 카운터는 KST 일자 버킷으로 영속화한다(DART 리셋이 KST 자정 기준).
# DARTFTC_RATE_WARN=18000
# DARTFTC_RATE_HARD_STOP=19000

# 검색 fan-out 동시성.
# ※ 변경 효과는 wave 수 ceil(task/동시성)로 계산할 것. 5→7은 wave 수가 같아 효과 0이다.
# DARTFTC_CONCURRENCY=10

# HTTP 타임아웃 — connect/read 분리 필수.
# read를 길게(응답 지연 흡수), connect/write/pool은 짧게(끊김 빠른 감지).
# 권장 관계: per-task >= read × 1.5 + 예상페이지수 × 페이지평균시간
# DARTFTC_HTTP_CONNECT_TIMEOUT=10
# DARTFTC_HTTP_READ_TIMEOUT=100

# per-task 타임아웃(초). 한 (코드,기간) task가 늦어도 그 task만 실패 처리하고
# 나머지 결과는 보존한다(partial_results=true). 전체 abort 금지.
# ※ 수학적 보장값이 아닌 운영 타협값이다.
# DARTFTC_PER_TASK_TIMEOUT=180

# 페이지네이션 상한. ⚠️ 낮추면 결과가 조용히 잘린다 (경고도 에러도 없음).
# J 카테고리는 90일 청크당 ~30페이지가 필요하다. total_page 보고 자동 종료하므로
# 상한을 올려도 불필요한 호출은 생기지 않는다.
# ※ 상한값보다 중요한 건 절단 시 diagnostics에 truncated + 실제 total_page를 노출하는 것.
# DARTFTC_MAX_PAGES=100

# 최종보고서만 조회할지 (DART last_reprt_at). ⚠️ 기본 false 유지할 것.
# true면 정정으로 대체된 원본 제출분이 사라져 "의결일 대비 기한 초과" 판정이 불가능해진다.
# 실측: 전체 N=14,597 / Y=12,794, J는 N=3,505 / Y=3,430 (Y ⊂ N, Y에만 있는 건 0)
# DARTFTC_LAST_REPORT_ONLY=false

# 적응형 날짜 분할 — 균등 분할 금지(결산·주총 시즌에 구조적으로 실패).
# 청크 신고 수가 THRESHOLD 이상이면 절반 분할, MIN_DAYS 이하로는 쪼개지 않는다.
# 측정 호출 예산 초과 시 FALLBACK_DAYS 균등 분할로 대체한다.
# DARTFTC_ADAPTIVE_THRESHOLD=1000
# DARTFTC_ADAPTIVE_MIN_DAYS=3
# DARTFTC_ADAPTIVE_FALLBACK_DAYS=30
# DARTFTC_ADAPTIVE_MEASURE_CONCURRENCY=5

# 원문 다운로드 상한 (초과 시 범위 축소 안내)
# DARTFTC_BODY_FETCH_LIMIT=50

# 로그 레벨 (stdout은 MCP 프로토콜 전용 — 로그는 stderr + 파일로만 나간다)
# DARTFTC_LOG_LEVEL=INFO
